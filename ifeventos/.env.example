# =====================================================================
# Nossos Eventos (IF Eventos) — modelo de variáveis de ambiente
# ---------------------------------------------------------------------
# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.
#
#   cp .env.example .env
#   # edite o .env
#
# Gerar uma SECRET_KEY nova:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# =====================================================================

# ---------- Núcleo do Django ----------
# Em produção: False. Com True, o Django expõe stack traces e configurações.
DEBUG=False

# Chave secreta do Django (obrigatória). Gere uma nova por ambiente.
SECRET_KEY=troque-esta-chave-por-uma-gerada

# Hosts aceitos. Em produção: o domínio público.
ALLOWED_HOSTS=ifeventos.lucianovilasboas.com.br

# Origens confiáveis para POST/CSRF. Sem isto, o login e os formulários
# falham atrás do proxy TLS. Inclua o esquema https://
CSRF_TRUSTED_ORIGINS=https://ifeventos.lucianovilasboas.com.br

# Endereço público do site (usado no QR code do certificado e em links absolutos)
SITE_URL=https://ifeventos.lucianovilasboas.com.br

# Origem do Socket.IO vista pelo NAVEGADOR.
#   - Vazio = mesma origem da página. É o correto atrás do Traefik
#     (o Traefik roteia /socket.io para a porta 8500 do contêiner).
#   - Em desenvolvimento sem proxy, use http://127.0.0.1:8500
SOCKET_URL=

# Endereço interno do servidor Socket.IO (mesmo contêiner, porta 8500).
# Só mude se separar o socket em outro serviço.
SOCKET_INTERNAL_URL=http://127.0.0.1:8500

# Fuso horário dos horários exibidos e das datas de atividade
TIME_ZONE=America/Sao_Paulo

# Em produção, o app fica atrás do proxy TLS (Traefik); o Django precisa
# confiar no X-Forwarded-Proto e redirecionar HTTP -> HTTPS.
#   produção:  USE_HTTPS_PROXY=True
#   dev local: USE_HTTPS_PROXY=False  (sem proxy, gera URLs http normais)
USE_X_FORWARDED_HOST=False
USE_HTTPS_PROXY=False
SECURE_SSL_REDIRECT=False

# ---------- Banco de dados (PostgreSQL) ----------
DB_NAME=django_db
DB_USER=django_user
DB_PASSWORD=troque-esta-senha
# "db" = nome do serviço no docker-compose (dentro da rede do Docker).
# Fora do Docker (rodando local), use 127.0.0.1
DB_HOST=db
DB_PORT=5432

# Atenção: o contêiner do PostgreSQL lê POSTGRES_*, não DB_*.
# Mantenha os três valores IDÊNTICOS aos de cima, senão o app não conecta.
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=troque-esta-senha

# ---------- Integrações ----------
# OpenAI (mensagem de boas-vindas e geração de descrição de evento)
OPENAI_API_KEY=

# Google (login social pelo allauth). Configure também no admin do Django.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA (opcional; hoje desativado no projeto)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Clima (usado em telas internas)
WEATHER_API_KEY=

# ---------- E-mail (SMTP) ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
# No Gmail, use uma "senha de app", não a senha da conta
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---------- Chamada de proposições de atividades ----------
# Avisos por e-mail (nova proposta para o organizador; decisão para o
# proponente). Deixe False até validar o SMTP acima — com credencial errada os
# envios falham em silêncio (só ficam no log).
PROPOSTAS_NOTIFICAR_EMAIL=False
# Propostas ATIVAS por pessoa em cada evento (0 = sem limite).
MAX_PROPOSTAS_POR_PROPONENTE=0

# ---------- Origens liberadas para a API REST (CORS) ----------
# Deixe vazio para não liberar nenhuma origem externa. Aceita lista separada por vírgula.
ALLOWED_API_HOSTS=

# ---------- Administração do banco (container pgadmin, opcional) ----------
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# ---------- Logs ----------
# Sem isto o stderr fica em buffer de bloco dentro do container: os tracebacks
# do Django não aparecem no `docker logs` (só o access log do gunicorn).
# Foi assim que o 500 do cadastro passou despercebido em 12/09/2026.
PYTHONUNBUFFERED=1
# Nivel dos logs da aplicacao: INFO (padrao) | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
